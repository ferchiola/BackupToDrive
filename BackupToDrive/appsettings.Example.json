// Copiá este archivo a appsettings.json y completá los valores.
// appsettings.json está en .gitignore: connection string, clave SMTP y el resto de secretos no se commitean.
// El programa lee appsettings.json desde la carpeta de salida (junto al .exe). Los comentarios están permitidos.
{
  "GoogleDrive": {
    // OAuth: abre el navegador la primera vez e inicia sesión con tu Gmail.
    //         El JSON es el cliente de escritorio (credentials/client_secret.json).
    //         Los archivos quedan en tu Drive, dentro de tu cuota.
    // ServiceAccount: job desatendido, sin navegador. El JSON es la clave de la cuenta de servicio.
    //         Esa cuenta no tiene espacio propio: hay que compartir una carpeta de tu Drive
    //         con el email ...@....gserviceaccount.com como Editor y poner su id en RootFolderId.
    "AuthMode": "OAuth",

    // Relativo a la carpeta del .exe, o una ruta absoluta.
    // OAuth: el client_secret descargado de Google Auth Platform → Clientes → Aplicación de escritorio.
    // ServiceAccount: el JSON de la clave de la cuenta de servicio.
    "CredentialsPath": "credentials/client_secret.json",

    // Solo OAuth. Acá se guarda el permiso después del primer login. Las corridas siguientes no abren el navegador.
    "TokenStorePath": "credentials/oauth-token",

    // Carpeta de Drive donde cuelga DrivePathTemplate.
    // Vacío + OAuth: la raíz de tu unidad (Mi unidad).
    // Vacío + ServiceAccount: no uses la raíz; la cuenta de servicio no tiene cuota.
    // El id es el tramo de la URL después de /folders/.
    "RootFolderId": "",

    // Nombre que ve Google en la pantalla de permiso. Tiene que coincidir con la app de Auth Platform.
    "ApplicationName": "BackupToDrive",

    // Después de subir, si el espacio libre no alcanza para N backups del tamaño del último archivo, manda mail-space.html.
    // El cupo es el de la cuenta (Drive + Gmail + Fotos). 0 no avisa.
    "SpaceAlertDays": 30
  },

  // Cada objeto es un backup distinto. Otra base, otra carpeta u otro destino = otro job.
  // Se corren los Enabled. Para uno solo: BackupToDrive --job Nombre
  "Jobs": [
    {
      // Nombre lógico. Entra en la ruta de Drive como {JobName}.
      "Name": "Default",
      "Enabled": true,

      // Servidor, base y usuario de SQL Server. Solo se usa si Steps.CreateBackup es true.
      // Usuario SQL:
      //   Server=localhost;Database=gead;User Id=usuario;Password=clave;TrustServerCertificate=True
      // Windows, sin usuario ni clave:
      //   Server=localhost;Database=gead;Integrated Security=True;TrustServerCertificate=True
      // El programa ejecuta BACKUP DATABASE y deja {Base}-{yyyyMMdd-HHmmss}.bak en SourceFolder.
      // Ese archivo lo escribe el servicio de SQL Server, en el equipo de la instancia:
      // la ruta tiene que existir ahí y el servicio necesita permiso de escritura.
      // El usuario SQL necesita permiso de backup sobre esa base.
      "ConnectionString": "Server=localhost;Database=gead;User Id=usuario;Password=clave;TrustServerCertificate=True",

      // Carpeta local que se lee y, si CreateBackup está prendido, donde cae el .bak nuevo.
      "SourceFolder": "C:\\Backups",

      // Varios patrones separados por ;
      // Con Compress prendido, los .rar que ya están en la carpeta no se vuelven a procesar.
      "SearchPattern": "*.bak;*.sql;*.zip;*.rar;*.7z",

      // true: también entra en subcarpetas de SourceFolder.
      "Recursive": false,

      // Ignora archivos modificados hace menos de N minutos (un .bak que SQL Server todavía está escribiendo).
      // 0 los toma igual. El .bak que acaba de crear este mismo job no espera: entra directo al pipeline.
      "MinAgeMinutes": 5,

      // Si en Drive ya hay un archivo con el mismo nombre y el mismo tamaño, no lo vuelve a subir.
      "SkipIfExistsOnDrive": true,

      // Carpetas que se crean debajo de RootFolderId. Barras / o \.
      // Tokens: {JobName} {yyyy} {MM} {dd}
      "DrivePathTemplate": "Backups/{JobName}/{yyyy}/{MM}",

      // Después de subir bien, borra en el momento el archivo local que se subió.
      "DeleteLocalAfterUpload": false,

      // Antes de generar el backup: borra *.rar de la carpeta de WinRAR más viejos que N días.
      // 0 borra todos los .rar que ya están y después genera el nuevo. Para no limpiar, Steps.CleanupLocal en false.
      // Drive no se toca. El .rar de esta corrida se crea después, así que queda.
      "LocalRetentionDays": 7,

      // Orden real: limpiar local → CreateBackup → buscar archivos → Compress → Upload → espacio en Drive → Notify.
      // Buscar archivos corre siempre. El resto solo si está en true.
      "Steps": {
        // Pide el BACKUP DATABASE de ConnectionString. Apagado hasta completar usuario y clave.
        "CreateBackup": false,
        // Comprime cada archivo pendiente con WinRAR y sube el .rar en lugar del original.
        // Si el .rar queda bien, WinRAR borra el archivo que compactó.
        "Compress": false,
        "Upload": true,
        // Manda el mail de abajo. También hace falta Mail.Enabled en true.
        "Notify": false,
        // Antes de generar, borra .rar locales según LocalRetentionDays. 0 borra los previos.
        "CleanupLocal": false
      },

      "Compress": {
        "WinRarPath": "C:\\Program Files\\WinRAR\\Rar.exe",
        // Argumentos de `rar a`, antes del archivo de salida y del origen.
        // -m5 es el método Best (m0 store, m1 fastest, m2 fast, m3 normal, m4 good, m5 best).
        // -ep1 guarda el archivo sin la ruta. -y no hace preguntas.
        "ExtraArguments": "-ep1 -m5 -y",
        // Vacío: el .rar queda al lado del archivo original.
        "OutputFolder": "",
        "TimeoutMinutes": 120
      }
    }
  ],

  "Mail": {
    // Interruptor general. Steps.Notify del job también tiene que estar en true.
    "Enabled": false,
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseSsl": true,
    "User": "",
    "Password": "",
    "From": "",
    "To": [ "" ],
    "NotifyOnSuccess": true,
    "NotifyOnFailure": true,
    // Carpeta junto al .exe. El cuerpo del mail es el HTML.
    // mail-ok.html si el job terminó bien; mail-error.html si falló en cualquier paso.
    // Placeholders: {{Job}} {{Fecha}} {{Resultado}} {{Origen}} {{Destino}} {{Mensaje}} {{Archivos}}
    // {{EspacioUsado}} {{EspacioTotal}} {{EspacioLibre}} {{DiasEstimados}} {{ArchivoReferencia}} {{UmbralDias}}
    // {{Mensaje}} junta los textos del paso que falló. No se incluye la connection string.
    "TemplatesFolder": "templates",
    "SuccessTemplate": "mail-ok.html",
    "FailureTemplate": "mail-error.html",
    "SpaceAlertTemplate": "mail-space.html"
  }
}
